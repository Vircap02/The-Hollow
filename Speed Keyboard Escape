--------------------------------------------------------------------------------
-- 5. LOGIKA UTAMA: AUTO FIRETOUCHINTERESTS
--------------------------------------------------------------------------------
task.spawn(function()
    while screenGui.Parent do
        if autoFarmActive and targetFolder then
            local currentCharacter = player.Character
            if currentCharacter then
                local currentRoot = currentCharacter:FindFirstChild("HumanoidRootPart")
                if currentRoot then
                    for _, coin in ipairs(targetFolder:GetChildren()) do
                        local touchPart = coin:FindFirstChildWhichIsA("BasePart") or (coin:IsA("BasePart") and coin)
                        if touchPart then
                            pcall(function()
                                firetouchinterest(currentRoot, touchPart, 0)
                                task.wait()
                                firetouchinterest(currentRoot, touchPart, 1)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)
