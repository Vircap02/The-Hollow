-- // Functionality Logic
local function runAutoProcess()
    local buyArgs = {
        "Halloween Candy Corn Carrot",
        "Scary Seeds"
    }
    
    while autoSellBuyEnabled do
        -- 1. Fire Sell Remote
        if SellRemote then
            SellRemote:FireServer()
            StatusLabel.Text = "Status: Selling Inventory..."
        else
            StatusLabel.Text = "Error: Sell Remote not found!"
        end
        
        task.wait(0.5)
        
        -- 2. Fire Buy Remote
        if BuyRemote then
            BuyRemote:FireServer(unpack(buyArgs))
            StatusLabel.Text = "Status: Buying Items..."
        else
            StatusLabel.Text = "Error: Buy Remote not found!"
        end
        
        task.wait(1) -- Delay per loop (bisa disesuaikan)
    end
end

-- Toggle Handler
ToggleBtn.MouseButton1Click:Connect(function()
    autoSellBuyEnabled = not autoSellBuyEnabled
    
    if autoSellBuyEnabled then
        ToggleBtn.Text = "Auto Sell & Buy: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        autoLoopThread = task.spawn(runAutoProcess)
    else
        ToggleBtn.Text = "Auto Sell & Buy: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        StatusLabel.Text = "Status: Stopped"
        if autoLoopThread then
            task.cancel(autoLoopThread)
            autoLoopThread = nil
        end
    end
end)

-- Minimize Functionality
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.3, true)
        MinimizeBtn.Text = "+"
        ContentFrame.Visible = false
    else
        MainFrame:TweenSize(UDim2.new(0, 300, 0, 180), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.3, true)
        MinimizeBtn.Text = "-"
        task.wait(0.1)
        ContentFrame.Visible = true
    end
end)

-- Close Functionality
